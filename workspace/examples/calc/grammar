%filenames parser
%scanner   scanner.h
%stype     int

%token NUMBER
%left  '+' '-'
%left  '*' '/'

%%

input:
    // empty
|
    input line
;

line:
    '\n'
|
    expr '\n'          { std::cout << $1 << '\n'; }
;

expr:
    expr '+' expr      { $$ = $1 + $3; }
|
    expr '-' expr      { $$ = $1 - $3; }
|
    expr '*' expr      { $$ = $1 * $3; }
|
    expr '/' expr      { $$ = $1 / $3; }
|
    '(' expr ')'       { $$ = $2; }
|
    NUMBER             { $$ = d_scanner.value(); }
;
