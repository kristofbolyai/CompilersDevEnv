# Build the example. `make` regenerates the scanner and parser whenever their
# specifications change, then compiles everything with the Debian 9 g++.

TARGET   := calc
CXX      := g++
CXXFLAGS := -std=c++14 -Wall -Wextra -O2

# Hand-written sources, kept in version control.
SOURCES  := main.cc
# Sources generated by bisonc++ / flexc++ - never edit these, they are
# overwritten on every run and are listed in .gitignore.
GENERATED_SOURCES := parse.cc lex.cc
GENERATED_HEADERS := parserbase.h scannerbase.h

OBJECTS  := $(SOURCES:.cc=.o) $(GENERATED_SOURCES:.cc=.o)

.PHONY: all run test clean

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(CXX) $(CXXFLAGS) -o $@ $^

parse.cc parserbase.h: grammar
	bisonc++ grammar

# flexc++ needs parserbase.h to already exist: the scanner's actions refer to
# the token constants bisonc++ defines there.
lex.cc scannerbase.h: lexer parserbase.h
	flexc++ lexer

main.o:  main.cc parser.h parserbase.h scanner.h scannerbase.h
parse.o: parse.cc parser.h parser.ih parserbase.h scanner.h scannerbase.h
lex.o:   lex.cc scanner.h scanner.ih scannerbase.h parserbase.h

%.o: %.cc
	$(CXX) $(CXXFLAGS) -c -o $@ $<

run: $(TARGET)
	./$(TARGET)

# A tiny regression check, so `./dev.sh test` has something to verify.
test: $(TARGET)
	@printf '1 + 2 * (10 - 4)\n100 / 7\n2 * 3 - 4 * 5\n' | ./$(TARGET) > .test.out
	@printf '13\n14\n-14\n' > .test.expected
	@diff -u .test.expected .test.out && echo "example: OK"
	@rm -f .test.out .test.expected

clean:
	rm -f $(TARGET) *.o $(GENERATED_SOURCES) $(GENERATED_HEADERS)
