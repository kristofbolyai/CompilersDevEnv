# --- Generated by bisonc++ / flexc++ -----------------------------------------
# These are rewritten from `grammar` and `lexer` on every build. The companion
# files that the generators create only once - parser.h, parser.ih, scanner.h,
# scanner.ih - are meant to be edited and *are* tracked.
parserbase.h
parse.cc
scannerbase.h
lex.cc

# --- Build output ------------------------------------------------------------
*.o
*.a
build/
cmake-build-*/
.test.out
.test.expected

# Compiled examples and assignments (no extension, so listed by name).
workspace/examples/calc/calc

# --- Editors and OS ----------------------------------------------------------
.idea/
.vscode/
*.swp
core
core.*
.DS_Store

# --- Student workspace ---------------------------------------------------------
# workspace/ is scratch space: assignment folders students create here (hazi1/,
# hazi2/, ...) shouldn't show up as untracked clutter in `git status`. The
# bundled example and its README ship with the repo and stay tracked, so they
# are carved back out. Each directory level needs its own "!" rule - git won't
# look inside a directory it has already decided to ignore.
/workspace/*
!/workspace/README.md
!/workspace/examples/
/workspace/examples/*
!/workspace/examples/calc/
