{
  // Dev Container definition for the ELTE Compilers environment.
  //
  // Works with JetBrains CLion / IntelliJ-based IDEs and with VS Code.
  // See README.md ("Using an IDE") for how to open it.
  //
  // Note that the image is pinned to linux/amd64 inside the Dockerfile itself
  // (FROM --platform=linux/amd64), because the Debian 9 toolchain packages only
  // exist for that architecture. Doing it there rather than through build
  // options keeps it working in every tool that reads this file.
  // Keep this a bare lowercase slug. CLion builds the image as
  // jb-devcontainer-<name>, so spaces, parentheses, "/" and "+" - anything not
  // legal in a Docker reference - make the build fail with "invalid tag".
  // The toolchain versions this pins are in the README instead.
  "name": "elte-compilers",

  "build": {
    "dockerfile": "../docker/Dockerfile",
    // The build context is the repository root: the Dockerfile copies
    // docker/entrypoint.sh, which lives outside .devcontainer.
    "context": ".."
  },

  // Mount the whole repository, but open the IDE on workspace/ - that is where
  // your own code belongs. Keeping the mount point fixed (rather than letting
  // it default to /workspaces/<folder name>) means paths are identical whether
  // you came in through the IDE or through ./dev.sh.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/elte-compilers,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/elte-compilers/workspace",

  "remoteUser": "student",

  "customizations": {
    "jetbrains": {
      "backend": "CLion"
    },
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.makefile-tools",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools-extension-pack",
        "daohong-emilio.yash"
      ],
      "settings": {
        "C_Cpp.default.cppStandard": "c++14",
        "C_Cpp.default.compilerPath": "/usr/bin/g++-6"
      }
    }
  },

  // CLion's backend writes its project configuration into .idea inside
  // workspaceFolder, and the bind mount puts it on the host. That leaves a
  // second project root nested inside the repository's own, which crashes the
  // IDE when the workspace is reopened.
  //
  // initializeCommand is the only lifecycle hook that runs on the host machine
  // rather than in the container, and it runs during initialization - on
  // container creation and on every subsequent start - so it is the one place
  // that can clear the directory before a window opens. The spec has no
  // host-side hook for closing, but clearing it on the way in covers the same
  // ground: a stale .idea only does harm when the next window opens.
  //
  // The chain below is what portability costs. /bin/sh takes the first form
  // and stops there; cmd.exe has no rm, so it falls through to rd; ver is a
  // no-op that keeps the exit status zero when there was nothing to delete,
  // which matters because a failing initializeCommand aborts the launch.
  //
  // No quotes and no ${localWorkspaceFolder} prefix here on purpose: this
  // hook already runs with that folder as its cwd, so a path relative to it
  // never contains a space and never needs quoting. That matters on Windows
  // specifically - initializeCommand is spawned as `cmd.exe /c <string>`
  // through node-pty, which escapes embedded quotes using the ordinary
  // CommandLineToArgvW convention (\" for a literal quote). cmd.exe's own
  // /c parser does not understand that convention - it just toggles
  // quoted-mode on every literal " - so a quoted absolute path here comes
  // out on the other side with a stray backslash grafted onto each end,
  // silently corrupting the path `rd` is asked to delete.
  "initializeCommand": "rm -rf workspace/.idea || rd /s /q workspace\\.idea 2>nul || ver >nul",

  "postCreateCommand": "g++ --version | head -1 && bisonc++ -v && flexc++ -v && flex --version"
}
