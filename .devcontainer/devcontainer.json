{
  // Dev Container definition for the ELTE Compilers environment.
  //
  // Works with JetBrains CLion / IntelliJ-based IDEs and with VS Code.
  // See README.md ("Using an IDE") for how to open it.
  //
  // Note that the image is pinned to linux/amd64 inside the Dockerfile itself
  // (FROM --platform=linux/amd64), because the Debian 9 toolchain packages only
  // exist for that architecture. Doing it there rather than through build
  // options keeps it working in every tool that reads this file.
  // Keep this a bare lowercase slug. CLion builds the image as
  // jb-devcontainer-<name>, so spaces, parentheses, "/" and "+" - anything not
  // legal in a Docker reference - make the build fail with "invalid tag".
  // The toolchain versions this pins are in the README instead.
  "name": "elte-compilers",

  "build": {
    "dockerfile": "../docker/Dockerfile",
    // The build context is the repository root: the Dockerfile copies
    // docker/entrypoint.sh, which lives outside .devcontainer.
    "context": ".."
  },

  // Mount the whole repository, but open the IDE on workspace/ - that is where
  // your own code belongs. Keeping the mount point fixed (rather than letting
  // it default to /workspaces/<folder name>) means paths are identical whether
  // you came in through the IDE or through ./dev.sh.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/elte-compilers,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/elte-compilers/workspace",

  "remoteUser": "student",

  "customizations": {
    "jetbrains": {
      "backend": "CLion"
    },
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.makefile-tools"
      ],
      "settings": {
        "C_Cpp.default.cppStandard": "c++14",
        "C_Cpp.default.compilerPath": "/usr/bin/g++-6"
      }
    }
  },

  "postCreateCommand": "g++ --version | head -1 && bisonc++ -v && flexc++ -v"
}
